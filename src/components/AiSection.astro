---
import Icon from './Icon.astro';

const useCases = [
  {
    icon: 'image',
    wrap: 'bg-cyan-400/10',
    tint: 'text-cyan-400',
    title: 'Generative Art Platforms',
    meta: 'Midjourney • Stable Diffusion • Flux • Custom models',
  },
  {
    icon: 'pen-nib',
    wrap: 'bg-purple-400/10',
    tint: 'text-purple-400',
    title: 'AI Copy + Design Systems',
    meta: 'Prompt-to-brand • Art direction at scale • Hybrid workflows',
  },
  {
    icon: 'lightbulb',
    wrap: 'bg-pink-400/10',
    tint: 'text-pink-400',
    title: 'Creative Studios &amp; Agencies',
    meta: 'Rebranding for the generative age • AI-first creative services',
  },
];
---

<section id="ai" class="bg-zinc-900 border-y border-white/10 py-14 sm:py-16">
  <div class="max-w-5xl mx-auto px-5 sm:px-6">
    <div class="grid md:grid-cols-12 gap-x-8 items-center">
      <div class="md:col-span-7 mb-9 md:mb-0">
        <p class="inline-flex items-center gap-x-2 px-3.5 py-1 rounded-2xl bg-gradient-to-r from-cyan-400/10 to-purple-500/10 border border-white/10 mb-4">
          <Icon name="sparkles" class="w-4 h-4 text-cyan-400" />
          <span class="text-[11px] font-bold tracking-[1.5px] text-cyan-400">THE AI CREATIVE REVOLUTION</span>
        </p>

        <h2 class="font-display section-title mb-5 sm:mb-6 text-white">
          AI is transforming art and copy.<br class="hidden sm:block" /> This domain owns the narrative.
        </h2>

        <div class="space-y-4 sm:space-y-5 text-base sm:text-lg text-zinc-300">
          <p>
            Generative AI has fundamentally changed how artists create visuals and how copywriters craft
            messages. The most successful creators and companies are those building the tools, platforms,
            and agencies that harness this new power.
          </p>

          <p class="font-medium text-white">
            edesigr.com is the semantic and professional home for exactly this moment.
          </p>
        </div>
      </div>

      <div class="md:col-span-5">
        <div class="bg-zinc-950 border border-white/10 rounded-3xl p-6 sm:p-8 ai-glow">
          <ul class="space-y-5 sm:space-y-6">
            {
              useCases.map((u) => (
                <li class="flex gap-4">
                  <span class={`mt-0.5 w-8 h-8 shrink-0 rounded-xl ${u.wrap} flex items-center justify-center`}>
                    <Icon name={u.icon} class={`w-4 h-4 ${u.tint}`} />
                  </span>
                  <span>
                    <span class="block font-semibold text-white" set:html={u.title} />
                    <span class="block text-sm text-zinc-400">{u.meta}</span>
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
