---
import Icon from './Icon.astro';
---

<section class="border-t border-white/10 bg-zinc-900 py-14 sm:py-16">
  <div class="max-w-xl mx-auto px-5 sm:px-6 text-center">
    <h2 class="font-display text-3xl sm:text-4xl tracking-tighter mb-4 text-white text-balance">
      Ready to own the professional future of design?
    </h2>
    <p class="text-zinc-400 mb-7 sm:mb-8 text-[15px] sm:text-base">
      This domain will not be available long. Secure the definitive .com before your competitors do.
    </p>

    <a
      href="#acquire"
      class="group inline-flex items-center justify-center gap-x-3 px-8 sm:px-10 min-h-[56px] rounded-3xl bg-white text-zinc-950 font-semibold text-base sm:text-lg hover:bg-zinc-100 active:scale-[0.985] transition-all shadow-xl"
    >
      Start the conversation
      <Icon name="arrow-right" class="w-5 h-5 group-hover:translate-x-1 transition-transform" />
    </a>

    <p class="mt-5 text-xs text-zinc-500">Direct from owner &bull; Confidential inquiries welcome</p>
  </div>
</section>
