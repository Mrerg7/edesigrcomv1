---
import { FAQS } from '../config/site';
import Icon from './Icon.astro';
---

<section id="faq" class="max-w-3xl mx-auto px-5 sm:px-6 pb-16 sm:pb-20">
  <div class="text-center mb-8">
    <p class="inline-block px-4 py-1 rounded-2xl bg-white/5 text-xs font-semibold tracking-[2px] mb-3">BUYER FAQ</p>
    <h2 class="font-display section-title text-white">Common questions</h2>
  </div>

  <div class="space-y-3">
    {
      FAQS.map((f, i) => (
        <details class="faq-item bg-zinc-900 border border-white/10 rounded-2xl overflow-hidden" open={i === 0}>
          <summary class="flex items-center justify-between gap-4 px-5 sm:px-7 py-4 sm:py-5 text-left text-[15px] sm:text-base font-medium text-zinc-300 hover:text-white transition-colors">
            <span>{f.q}</span>
            <Icon name="chevron-down" class="faq-chevron w-4 h-4 shrink-0 text-zinc-500 transition-transform duration-200" />
          </summary>
          <div class="px-5 sm:px-7 pb-5 sm:pb-6 -mt-1 text-zinc-400 text-[15px] leading-relaxed">{f.a}</div>
        </details>
      ))
    }
  </div>

  <p class="text-center text-sm text-zinc-500 mt-6">
    Still have questions?
    <a href="mailto:sales@desertrich.com?subject=Question%20about%20edesigr.com" class="text-cyan-400 hover:text-cyan-300 underline underline-offset-2 py-1.5">Ask the owner directly</a>.
  </p>
</section>
