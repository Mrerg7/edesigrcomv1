---
import Icon from './Icon.astro';

const audiences = [
  {
    icon: 'robot',
    border: 'hover:border-cyan-400/30',
    tint: 'text-cyan-400',
    title: 'AI Art & Design Tools',
    body: 'Launch or rebrand your generative platform, prompt marketplace, or AI design SaaS with instant category authority and professional credibility.',
  },
  {
    icon: 'users',
    border: 'hover:border-purple-400/30',
    tint: 'text-purple-400',
    title: 'Digital Design Agencies',
    body: 'Position your studio as the leader in AI-augmented creative services with a .com that signals professionalism and long-term vision.',
  },
  {
    icon: 'palette',
    border: 'hover:border-pink-400/30',
    tint: 'text-pink-400',
    title: 'Generative Artists & Creators',
    body: 'Establish a premium personal or collective brand for AI-assisted illustration, motion, and visual storytelling with maximum trust.',
  },
  {
    icon: 'file-lines',
    border: 'hover:border-emerald-400/30',
    tint: 'text-emerald-400',
    title: 'AI Copy + Art Platforms',
    body: 'Own the space where intelligent copy meets stunning visuals — the future of advertising, branding, and content creation.',
  },
  {
    icon: 'globe',
    border: 'hover:border-amber-400/30',
    tint: 'text-amber-400',
    title: 'Creative Tech Startups',
    body: 'Secure a memorable, high-signal .com for your next round. Investors and clients notice brands that own the professional standard.',
  },
  {
    icon: 'infinity',
    border: 'hover:border-rose-400/30',
    tint: 'text-rose-400',
    title: 'NFT & Web3 Creative Projects',
    body: 'Professional .com credibility meets on-chain creativity. Ideal for generative collections, metaverse studios, and serious digital art platforms.',
  },
];
---

<section id="for" class="max-w-5xl mx-auto px-5 sm:px-6 py-14 sm:py-16">
  <div class="text-center mb-9 sm:mb-10">
    <p class="inline-block px-4 py-1 rounded-2xl bg-white/5 text-xs font-semibold tracking-[2px] mb-3">WHO THIS DOMAIN IS FOR</p>
    <h2 class="font-display section-title text-white">
      Built for the new<br class="hidden sm:block" /> creative class.
    </h2>
  </div>

  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5">
    {
      audiences.map((a) => (
        <article class={`group premium-card bg-zinc-900 border border-white/10 ${a.border} rounded-3xl p-6 sm:p-7`}>
          <Icon name={a.icon} class={`w-8 h-8 ${a.tint} mb-4`} />
          <h3 class="font-semibold text-lg sm:text-xl tracking-tight mb-2 text-white">{a.title}</h3>
          <p class="text-zinc-400 text-[15px] leading-relaxed">{a.body}</p>
        </article>
      ))
    }
  </div>
</section>
