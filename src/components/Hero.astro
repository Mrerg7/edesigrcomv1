---
import { ACQUISITION_MAILTO } from '../config/site';
import Icon from './Icon.astro';
---

<section class="pt-20 pb-14 sm:pt-24 sm:pb-20 border-b border-white/10 creative-grid">
  <div class="max-w-5xl mx-auto px-5 sm:px-6 text-center">
    <div class="inline-flex items-center gap-x-2 px-3.5 py-1.5 rounded-3xl bg-white/5 border border-white/10 mb-5 sm:mb-6">
      <span class="w-2 h-2 bg-emerald-400 rounded-full animate-pulse shrink-0" aria-hidden="true"></span>
      <span class="text-[10px] sm:text-xs font-medium tracking-[1.2px] sm:tracking-[1.5px] text-emerald-400">
        PREMIUM .COM DOMAIN • FOR SALE
      </span>
    </div>

    <h1 class="font-display text-[clamp(2.75rem,13vw,4.75rem)] leading-[0.95] tracking-[-0.055em] mb-4 text-balance">
      <span class="text-white">edesigr</span><span class="monster-gradient">.com</span>
    </h1>

    <p class="max-w-2xl mx-auto text-xl sm:text-2xl md:text-3xl font-medium tracking-tight text-zinc-300 mb-7 sm:mb-8 text-balance">
      The definitive .com for the electronic designer &amp; AI creative.
    </p>

    <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-3 sm:gap-4 mb-8 sm:mb-10">
      <a
        href="#acquire"
        class="group w-full sm:w-auto inline-flex items-center justify-center gap-x-3 px-7 sm:px-9 py-4 text-base sm:text-lg font-semibold rounded-3xl bg-white text-zinc-950 hover:bg-zinc-100 active:scale-[0.985] transition-all shadow-xl shadow-black/20"
      >
        <span>Acquire for $195,000</span>
        <Icon name="arrow-right" class="w-5 h-5 group-hover:translate-x-1 transition-transform" />
      </a>
      <a
        href={ACQUISITION_MAILTO}
        class="w-full sm:w-auto inline-flex items-center justify-center gap-x-2 px-7 sm:px-8 py-4 text-base sm:text-lg font-medium rounded-3xl border border-white/20 hover:bg-white/5 transition-all text-zinc-100"
      >
        <Icon name="envelope" class="w-5 h-5" />
        <span>Make an offer</span>
      </a>
    </div>

    <ul class="flex flex-wrap items-center justify-center gap-x-5 sm:gap-x-8 gap-y-2 text-[13px] sm:text-sm text-zinc-500">
      <li class="flex items-center gap-x-2">
        <Icon name="check" class="w-4 h-4 text-emerald-400 shrink-0" />
        <span>Escrow-protected transfer</span>
      </li>
      <li class="flex items-center gap-x-2">
        <Icon name="check" class="w-4 h-4 text-emerald-400 shrink-0" />
        <span>Instant brand recognition</span>
      </li>
      <li class="flex items-center gap-x-2">
        <Icon name="check" class="w-4 h-4 text-emerald-400 shrink-0" />
        <span>AI-era ready .com</span>
      </li>
    </ul>
  </div>
</section>
