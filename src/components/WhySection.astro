---
import Icon from './Icon.astro';

const cards = [
  {
    icon: 'globe',
    wrap: 'bg-cyan-400/10',
    tint: 'text-cyan-400',
    title: 'Instant Global Recognition',
    body: '&ldquo;edesigr&rdquo; is the natural, stylized shorthand for <span class="text-white font-medium">Electronic Designer</span>. The .com extension delivers immediate trust, professionalism, and worldwide familiarity that no other TLD can match.',
  },
  {
    icon: 'palette',
    wrap: 'bg-purple-400/10',
    tint: 'text-purple-400',
    title: 'Built for the AI Creative Era',
    body: 'The intersection of electronic design, generative art, and intelligent copy is exploding. This domain positions you at the exact center of that revolution — where prompts become pixels and AI becomes your creative partner.',
  },
  {
    icon: 'envelope',
    wrap: 'bg-pink-400/10',
    tint: 'text-pink-400',
    title: 'Professional Brand Infrastructure',
    body: 'A premium .com gives you clean email addresses (hello@edesigr.com), seamless client communication, and the strongest possible foundation for marketing, SEO, and long-term brand equity.',
  },
  {
    icon: 'shield-halved',
    wrap: 'bg-emerald-400/10',
    tint: 'text-emerald-400',
    title: 'Timeless & Ownable',
    body: 'Short, distinctive, and brandable. &ldquo;Visit edesigr.com&rdquo; is easy to say, easy to remember, and projects stability and seriousness. In a world of long or gimmicky domains, this stands out as the professional standard.',
  },
];
---

<section id="why" class="max-w-5xl mx-auto px-5 sm:px-6 pt-14 sm:pt-16 pb-12">
  <div class="text-center mb-10 sm:mb-12">
    <p class="inline-block px-4 py-1 rounded-2xl bg-white/5 text-xs font-semibold tracking-[2px] mb-3">THE DEFINITIVE .COM</p>
    <h2 class="font-display section-title text-white">
      Why edesigr.com<br class="hidden sm:block" /> is the professional choice.
    </h2>
  </div>

  <div class="grid md:grid-cols-2 gap-5">
    {
      cards.map((c) => (
        <div class="premium-card bg-zinc-900 border border-white/10 rounded-3xl p-6 sm:p-8">
          <div class={`w-11 h-11 sm:w-12 sm:h-12 rounded-2xl ${c.wrap} flex items-center justify-center mb-5 sm:mb-6`}>
            <Icon name={c.icon} class={`w-6 h-6 ${c.tint}`} />
          </div>
          <h3 class="text-xl sm:text-2xl font-semibold tracking-tight mb-3 text-white">{c.title}</h3>
          <p class="text-zinc-400 leading-relaxed text-[15px] sm:text-base" set:html={c.body} />
        </div>
      ))
    }
  </div>
</section>
